@model FinControl.Models.Despesa

@{
    ViewData["Title"] = "Excluir Despesa";
}

<div class="container mt-4">

    <h1>🗑️ Excluir Despesa</h1>

    <hr />

    <div class="alert alert-warning">
        Tem certeza de que deseja excluir esta despesa?
        Esta ação não pode ser desfeita.
    </div>

    <dl class="row">
        <dt class="col-sm-3">Descrição</dt>
        <dd class="col-sm-9">@Model.Descricao</dd>

        <dt class="col-sm-3">Valor</dt>
        <dd class="col-sm-9">@Model.Valor.ToString("C2", new System.Globalization.CultureInfo("pt-BR"))</dd>

        <dt class="col-sm-3">Vencimento</dt>
        <dd class="col-sm-9">@Model.DataVencimento.ToString("dd/MM/yyyy")</dd>

        <dt class="col-sm-3">Categoria</dt>
        <dd class="col-sm-9">@Model.Categoria</dd>

        <dt class="col-sm-3">Status</dt>
        <dd class="col-sm-9">@(Model.Pago ? "Pago" : "Pendente")</dd>
    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />

        <button type="submit" class="btn btn-danger">
            Confirmar exclusão
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Cancelar
        </a>
    </form>

</div>
