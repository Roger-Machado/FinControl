@model FinControl.Models.Receita

@{
    ViewData["Title"] = "Nova Receita";
}

<h1>💰 Nova Receita</h1>

<hr />

<form asp-action="Create" method="post">

    <div class="mb-3">
        <label asp-for="Descricao" class="form-label"></label>
        <input asp-for="Descricao" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Valor" class="form-label"></label>
        <input asp-for="Valor" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="DataRecebimento" class="form-label"></label>
        <input asp-for="DataRecebimento" type="date" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Categoria" class="form-label"></label>
        <input asp-for="Categoria" class="form-control" />
    </div>

    <button type="submit" class="btn btn-success">
        Salvar
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Voltar
    </a>

</form>