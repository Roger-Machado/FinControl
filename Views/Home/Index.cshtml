@using System.Globalization

@{
    ViewData["Title"] = "Dashboard";
}

<div class="text-center mt-5">
    <h1 class="display-4">📊 FinControl</h1>

    <p class="lead">
        Sistema de Controle Financeiro Pessoal
    </p>

    <hr />

    <div class="row mt-4">

        <div class="col-md-3">
            <div class="card shadow">
                <div class="card-body">
                    <h5>Saldo Atual</h5>
                    <h3 class="text-success">
                        @(((decimal)ViewBag.SaldoAtual).ToString("C2", new CultureInfo("pt-BR")))
                    </h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow">
                <div class="card-body">
                    <h5>Receitas</h5>
                    <h3 class="text-primary">
                        @(((decimal)ViewBag.TotalReceitas).ToString("C2", new CultureInfo("pt-BR")))
                    </h3>       
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow">
                <div class="card-body">
                    <h5>Despesas</h5>
                    <h3 class="text-danger">
                        @(((decimal)ViewBag.TotalDespesas).ToString("C2", new CultureInfo("pt-BR")))
                    </h3>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card shadow">
                <div class="card-body">
                    <h5>Cartão</h5>
                    <h3 class="text-warning">R$ 0,00</h3>
                </div>
            </div>
        </div>

    </div>
</div>